# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vagare?schema=public"

# JWT
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio
JWT_EXPIRES_IN=24h

# Google OAuth (Client ID do Google Cloud Console)
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com

# E-mail (Gmail SMTP) — recuperação de senha
# Sem GMAIL_USER/GMAIL_APP_PASSWORD, o link de reset é apenas logado no console (útil em dev/test)
# Gere a senha de app em: https://myaccount.google.com/apppasswords (exige verificação em 2 etapas)
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Vagare
RESET_PASSWORD_URL=vagareapp://reset-password
